# Copia este archivo a .env y ajusta los valores:  cp .env.example .env

# Puerto del host donde se publica la aplicación (el contenedor siempre usa 8501)
APP_PORT=8501

# Zona horaria del contenedor (afecta fechas de envíos, licencias y alertas)
TZ=America/Bogota

# Opcional: token de Mapbox. Si se define, los mapas usan
# mapbox://styles/mapbox/dark-v11; si se deja vacío, se usa CARTO Dark Matter
# (no requiere token).
MAPBOX_API_KEY=
