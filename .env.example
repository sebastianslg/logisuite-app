# Copia este archivo a .env y ajusta los valores:  cp .env.example .env

# Puertos publicados en el host
WEB_PORT=3000
API_PORT=8000

# Zona horaria (afecta salidas, ETA y estados de los envíos)
TZ=America/Bogota

# Orígenes permitidos por CORS para llamadas directas a la API. El navegador
# usa el proxy /api del frontend, así que normalmente no hace falta tocarlo.
CORS_ORIGINS=http://localhost:3000

# Estilo del mapa base (MapLibre). Si lo dejas comentado, el mapa sigue la apariencia elegida
# (OpenFreeMap Positron en claro, Dark en oscuro; libres también para uso comercial). Si lo defines, fija
# un único estilo; si es de otro proveedor, agrega su dominio a MAP_HOSTS en frontend/next.config.ts.
# Se incrusta al compilar el frontend: tras cambiarlo, reconstruye la imagen.
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Dominio público (lo usan Caddy para el certificado HTTPS y la vigilancia del sitio)
# DOMAIN=westvane.duckdns.org

# Avisos al celular (ntfy): cuando el sitio cae y vuelve (deploy/healthcheck.sh), y desde la app cuando se
# registra una incidencia en ruta o se cierra una vía o un nodo. Instala la app ntfy (Android o iPhone),
# suscríbete a un nombre difícil de adivinar y escríbelo aquí. Vacío = sin avisos.
# NTFY_TOPIC=westvane-avisos-cambia-este-nombre

# Aviso si el respaldo diario falla o no corre (deploy/backup.sh). Crea un chequeo diario gratis en
# https://healthchecks.io y pega aquí su URL de ping. Vacío = sin aviso.
# HC_PING_URL=https://hc-ping.com/tu-uuid

# Buscadores: mientras la app sea privada no se indexa. Ponlo en 1 al lanzarla al público y reconstruye.
# ALLOW_INDEXING=1

# Responsable del tratamiento de datos (Términos, Política de datos y aviso de privacidad). Mientras falten
# los cuatro primeros, esos documentos se muestran como borrador con los datos marcados en amarillo.
# LEGAL_NAME=Nombre completo o razón social
# LEGAL_ID=C.C. 1.000.000.000  (o NIT 900.000.000-1)
# LEGAL_CITY=Bogotá
# LEGAL_EMAIL=datos@tudominio.com
# LEGAL_ADDRESS=Calle 00 # 00-00 (opcional)
# LEGAL_PHONE=+57 300 000 0000 (opcional)
# Ubicación del centro de datos de Contabo (aparece en el panel), p. ej. "Estados Unidos (St. Louis)"
# SERVER_LOCATION=
